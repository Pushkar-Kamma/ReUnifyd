# =============================================================================
# ReUnifyd — Backend environment template
# Copy to `.env` and fill in. Never commit `.env` to git.
# Generate strong random values for *_SECRET / *_KEY (see comments below).
# =============================================================================

# --- App ---
ENVIRONMENT=development            # development | production
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Local dev: SQLite is fine
DATABASE_URL=sqlite:///./dev.db
# Production: use Supabase Transaction Pooler URL (port 6543), e.g.
# DATABASE_URL=postgresql://postgres.<project>:<PWD>@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- Sessions / cookies ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_me

# --- JWT (legacy, used for session tokens) ---
# Generate the same way as SESSION_SECRET
JWT_SECRET=replace_me

# --- Token encryption (OAuth tokens stored in DB) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key invalidates all stored OAuth tokens — users must reconnect
FERNET_KEY=replace_me

# --- Google OAuth (YouTube) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- CORS ---
# Comma-separated origins allowed to call the API (cookies require explicit origins, not '*')
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Email (Resend) — optional in dev ---
RESEND_API_KEY=
EMAIL_FROM=noreply@edstart.xyz

# --- Error tracking (Sentry) — optional ---
SENTRY_DSN=
